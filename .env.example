# Copy this file to .env if you want a local shell helper, but do not commit real secrets.

# Required only when using:
#   python3 scripts/run_llm_rerank.py --provider deepseek ...
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key

# Optional. Defaults are already encoded in scripts/llm_client.py.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Point this to your local Defects4J installation.
DEFECTS4J_HOME=/path/to/defects4j
